# Apple Magic Keyboard: expose Globe/Fn as an ordinary F20 key.
# KEY_FN exceeds X11's keycode range. No Alt modifier or XF86Dictate keysym.
# Cover the vendor Fn usage and the possible F20 usage; confirm with evtest.
# This replaces Fn behavior for function-key combinations.
evdev:input:b0003v05ACp0320*
 KEYBOARD_KEY_00ff0003=f20
 KEYBOARD_KEY_7006f=f20
