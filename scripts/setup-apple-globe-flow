#!/usr/bin/env bash
# Run with sudo to expose Globe as F20. Wispr Flow's saved push-to-talk
# binding must also be F20; its shortcut recorder rejects standalone F-keys.
set -euo pipefail

if (( EUID != 0 )); then
    echo "Run: sudo $0" >&2
    exit 1
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
target=/etc/udev/hwdb.d/90-apple-globe-flow.hwdb

# Query the actual HID keymap before changing any system file. This does not
# capture typed keys. Refuse an unexpected device or scancode rather than guess.
check_globe_mapping() {
    /usr/bin/python3 - "$1" <<'PY'
import fcntl
import pathlib
import struct
import sys

verify = sys.argv[1] == "verify"
seen = 0
for device in pathlib.Path('/sys/class/input').glob('event*'):
    modalias = (device / 'device/modalias').read_text().strip()
    if not modalias.startswith('input:b0003v05ACp0320'):
        continue
    with open('/dev/input/' + device.name, 'rb', buffering=0) as stream:
        entry = bytearray(struct.pack('II', 0x00ff0003, 0))
        fcntl.ioctl(stream, 0x80084504, entry, True)  # EVIOCGKEYCODE
        _, code = struct.unpack('II', entry)
    expected = (190,) if verify else (464, 190)  # KEY_FN, KEY_F20
    if code not in expected:
        sys.exit(f'{device.name}: unexpected Globe keycode {code}; stopping.')
    print(f'{device.name}: HID 00ff0003 -> Linux keycode {code}')
    seen += 1
if not seen:
    sys.exit('No connected USB Magic Keyboard 05ac:0320 found; stopping.')
PY
}

check_globe_mapping before
if [[ -f $target ]]; then
    cp -a -- "$target" "$target.before-fix.$(date +%Y%m%d-%H%M%S)"
fi
install -Dm644 "$script_dir/apple-globe-flow.hwdb" "$target"
systemd-hwdb update

# Re-apply the mapping to every already-connected Apple Magic Keyboard so the
# key works without a reboot.
keyboard_seen=0
for device in /sys/class/input/event*; do
    modalias=$(cat "$device/device/modalias" 2>/dev/null || true)
    if [[ $modalias == input:b0003v05ACp0320* ]]; then
        udevadm trigger --action=change "$device"
        keyboard_seen=1
    fi
done
udevadm settle
check_globe_mapping verify

if (( keyboard_seen )); then
    echo 'Globe is mapped to F20. If Wispr Flow ignores it, reconnect the keyboard.'
else
    echo 'No Apple Magic Keyboard found. Reconnect it so the F20 mapping applies.'
fi
echo 'Verified: Globe now emits KEY_F20 (190), which reaches X11 as keycode 198.'
echo 'Wispr Flow must have F20 (131) assigned to push-to-talk.'
echo 'Reload i3 (Super+Shift+r) to restore the F20 X11 keysym after the device update.'
echo 'Verify in X11 with: xinput test-xi2 --root (Globe should report detail 198).'
echo 'To undo: remove /etc/udev/hwdb.d/90-apple-globe-flow.hwdb, run systemd-hwdb update, and reconnect the keyboard.'
