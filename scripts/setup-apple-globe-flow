#!/usr/bin/env bash
# Run with sudo, then record the Globe key (as F20) in Wispr Flow's shortcut
# settings. Safe to re-run: it always installs the verified Globe remap.
set -euo pipefail

if (( EUID != 0 )); then
    echo "Run: sudo $0" >&2
    exit 1
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
target=/etc/udev/hwdb.d/90-apple-globe-flow.hwdb

install -Dm644 "$script_dir/apple-globe-flow.hwdb" "$target"
systemd-hwdb update

# Re-apply the mapping to every already-connected Apple Magic Keyboard so the
# key works without a reboot.
keyboard_seen=0
for device in /sys/class/input/event*; do
    modalias=$(cat "$device/device/modalias" 2>/dev/null || true)
    if [[ $modalias == input:b0003v05ACp0320* ]]; then
        udevadm trigger --action=change "$device"
        keyboard_seen=1
    fi
done
udevadm settle

if (( keyboard_seen )); then
    echo 'Globe is mapped to F20. If Wispr Flow ignores it, reconnect the keyboard.'
else
    echo 'No Apple Magic Keyboard found. Reconnect it so the F20 mapping applies.'
fi
echo 'Record Globe (F20) in Wispr Flow Settings -> Shortcuts.'
echo 'Verify with: showkey --scancodes  (Globe should print 0x6f on press).'
echo 'To undo: remove /etc/udev/hwdb.d/90-apple-globe-flow.hwdb, run systemd-hwdb update, and reconnect the keyboard.'
