#!/usr/bin/env bash
# Run with sudo, then record the Globe key in Wispr Flow's shortcut settings.
set -euo pipefail

if (( EUID != 0 )); then
    echo "Run: sudo $0" >&2
    exit 1
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
install -Dm644 "$script_dir/apple-globe-flow.hwdb" \
    /etc/udev/hwdb.d/90-apple-globe-flow.hwdb
systemd-hwdb update

for device in /sys/class/input/event*; do
    if [[ $(< "$device/device/modalias") == input:b0003v05ACp0320* ]]; then
        udevadm trigger --action=change "$device"
    fi
done
udevadm settle
echo 'Reconnect the keyboard, then reload i3 to apply the F20 keysym.'
echo 'Record Globe as F20 in Wispr Flow Settings -> Shortcuts.'
echo 'If no key is detected, capture Globe with sudo evtest on the Apple keyboard to verify its MSC_SCAN code.'
echo 'To undo: remove /etc/udev/hwdb.d/90-apple-globe-flow.hwdb, run systemd-hwdb update, and reconnect the keyboard.'
