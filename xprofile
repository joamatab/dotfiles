# dwmstatus 2>&1
# redshift -P -O 2000 &

# ssh-agent -a ${XDG_RUNTIME_DIR}/ssh-agent.socket &
ssh-agent -a "${SSH_AUTH_SOCK}" &
# Single setxkbmap call: layout + option together so CapsLock->Ctrl is applied
# atomically. Two separate calls (one backgrounded) used to race and leave
# CapsLock in mod4 (Super) instead of control.
#
# This is the ONLY place Caps Lock is remapped -- it owns keycode 66 and the
# Lock modifier. Do not add raw `xmodmap -e "keycode 66 = ..."` lines (in
# i3/config or elsewhere): those re-fire on i3 reload and revert this keymap.
setxkbmap -layout us -option ctrl:nocaps
xmodmap -e "keycode 160 = Print"
# Ordinary F20 for Globe dictation; no extra modifier or exotic keysym.
xmodmap -e "keycode 198 = F20"
xset r rate 250 35 # Repeat after 250 ms at 35 keys/sec
clipmenud &
