# vim: foldmethod=marker foldlevel=1
# see http://i3wm.org/docs/userguide.html for a complete reference!
# Variables {{{
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
gaps inner 5
gaps outer 0
workspace_layout default
# Repeat after 200 ms at 50 keys/sec.
exec_always --no-startup-id xset r rate 200 50
# macOS maps Caps Lock to left Control. That mapping is owned entirely by
# xprofile's `setxkbmap -layout us -option ctrl:nocaps` (one atomic call at
# login) -- do NOT re-map keycode 66 here. Running `exec_always xmodmap` with
# raw keycode 66 / mod4 edits re-fires on every i3 reload and fights the
# setxkbmap keymap, which is what kept silently reverting Caps Lock.
# Only re-assert the Globe key (keycode 198 -> F20) here, because setxkbmap in
# xprofile may run after i3 and the hwdb mapping is per-keyboard, not per-keymap.
exec_always --no-startup-id xmodmap -e "keycode 198 = F20"
# Wispr Flow renders an opaque-black ~200x110 "Status" window at the bottom of
# the screen (an Electron transparent overlay). It is an *override-redirect*
# window, so i3 never manages it -- `for_window ... move to scratchpad` does
# nothing. wispr-hide-status unmaps it and keeps re-hiding it across launches,
# which removes the black box entirely.
exec_always --no-startup-id ~/.local/bin/wispr-hide-status &
# Start Wispr Flow on login (give i3/X a moment to settle first).
exec --no-startup-id sh -c 'sleep 3; ~/.local/bin/wispr-flow'
# Click the network icon in the tray to select Wi-Fi networks.
exec --no-startup-id nm-applet
# The HDMI monitor sits to the left of the DisplayPort monitor.
exec --no-startup-id xrandr --output HDMI-A-0 --primary --pos 0x0 --output DisplayPort-2 --pos 1920x0
floating_modifier $mod
# }}}
# Keybindings {{{
bindsym $mod+Delete exec dmenurecord kill
bindsym $mod+Print exec dmenurecord
bindsym $mod+Return exec env TERMINAL=ghostty i3-sensible-terminal -e fish
bindsym $mod+Shift+e restart
bindsym $mod+Shift+i exec google-chrome-stable --force-dark-mode
bindsym $mod+Shift+r reload
bindsym $mod+Ctrl+l exec i3lock
bindsym $mod+Ctrl+h exec --no-startup-id ~/.local/bin/neru hints
bindsym $mod+Shift+x exec --no-startup-id flameshot gui
# XRDP can miss a macOS modifier-key release. Reset its keyboard device.
bindsym Mod4+Shift+Escape exec --no-startup-id xinput disable xrdpKeyboard && xinput enable xrdpKeyboard && rofi -e "RDP keyboard reset"
bindsym Mod1+Shift+Escape exec --no-startup-id xinput disable xrdpKeyboard && xinput enable xrdpKeyboard && rofi -e "RDP keyboard reset"
bindsym Control+Shift+Escape exec --no-startup-id xinput disable xrdpKeyboard && xinput enable xrdpKeyboard && rofi -e "RDP keyboard reset"
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+c exec clipmenu
bindsym $mod+d exec "rofi -show run"
# Spotlight-style application search (Command/Super + Space).
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+i exec firefox
bindsym $mod+m move workspace to output left
bindsym $mod+q kill
bindsym $mod+x exec rofi -show window
bindsym Print exec flameshot gui
# }}}
# Windows {{{
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
# }}}
# Resizing {{{
mode "resize" {
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
bindsym $mod+comma resize grow width 10 px or 10 ppt
bindsym $mod+period resize shrink width 10 px or 10 ppt
# }}}
# Workspaces {{{
# Keep workspace 9 on the left monitor.
workspace 9 output HDMI-A-0
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10
# }}}
# Layout {{{
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+space focus mode_toggle
bindsym $mod+a focus parent
default_border pixel 1
# }}}
# Special keys {{{
bindsym XF86MonBrightnessUp exec light -A 5
bindsym XF86MonBrightnessDown exec light -U 5
bindsym XF86Reload exec playerctl play-pause
bindsym XF86Back exec playerctl previous
bindsym XF86Forward exec playerctl next
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86Tools exec gnome-control-center
bindsym XF86Display exec dock-it
# }}}
# Status Bar {{{
bar {
    status_command i3status -c ~/.config/i3status/config
    position bottom
    height 36
    tray_padding 6
    bindsym button4 nop
    bindsym button5 nop
    font pango:URWGothic-Book 11
    strip_workspace_numbers yes
}
# }}}

# Faster Magic Trackpad pointer movement.
exec_always --no-startup-id ~/.local/bin/trackpad-speed
